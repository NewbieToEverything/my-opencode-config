    "strata": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "Strata (Qwen3.8-Flash-Next 125B)",
      "settings": {
        "baseURL": "http://localhost:8089/v1",
        "apiKey": "anything"
      },
      "models": {
        "strata": {
          "name": "Qwen3.8-Flash-Next (high, 默认)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "options": {
            "reasoningEffort": "high"
          }
